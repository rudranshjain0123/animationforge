# Hack Club sign-in is required for Studio. Keep the actual .env on the server.
APP_ORIGIN=https://animationforge.rudranshjain0123.hackclub.app
PORT=3000
HACKCLUB_CLIENT_ID=your_client_id
HACKCLUB_CLIENT_SECRET=
# Name is an OIDC claim released through Hack Club's profile scope.
HACKCLUB_OIDC_SCOPE="openid email profile"
# Optional override. Use a writable persistent directory outside public assets.
DATABASE_PATH=data/animationforge.sqlite
