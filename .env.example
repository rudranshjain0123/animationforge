# Optional Hack Club sign-in. Keep the actual .env on the server.
APP_ORIGIN=https://animationforge.rudranshjain0123.hackclub.app
PORT=3000
HACKCLUB_CLIENT_ID=your_client_id
HACKCLUB_CLIENT_SECRET=
# Set to "openid email profile" only after approving that scope.
# Hack Club Auth exposes name through profile and does not support a name scope.
HACKCLUB_OIDC_SCOPE=
